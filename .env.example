# Copy to .env and fill in. NEVER commit .env.
# Optional Gerrit auth for scripts/webhooks. The dashboard instead asks users to
# sign in with Gerrit HTTP credentials and retains them only in a local session.
GERRIT_AUTH=
GERRIT_USER=
GERRIT_HTTP_PASSWORD=

# Shared secret the dashboard sends as `X-Auth-Token` to the local API.
API_TOKEN=change-me

# Needed only when review.strategy = "direct". OpenAI-compatible model key.
MODEL_API_KEY=

# Shared secret Gerrit sends in X-Webhook-Secret to POST /hooks/gerrit.
WEBHOOK_SECRET=
